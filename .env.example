# =============================================
# HardwareAI v2 — Environment Variables
# =============================================
# Copy to .env.local and fill in your values
# NEVER commit .env or .env.local to git

# ── Gemini AI ────────────────────────────────────────────────────────────────
# Get from: Google AI Studio (aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# Setup: developers.facebook.com > Create App > Add WhatsApp product
# Template name required: reorder_request (see whatsappService.js for body)
VITE_META_WHATSAPP_TOKEN=your_meta_whatsapp_access_token_here
VITE_META_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# ── App URL (used in WhatsApp purchase order links) ──────────────────────────
# Set to your deployed URL, e.g. https://forgera.vercel.app
VITE_APP_URL=https://forgera-rho.vercel.app

# ── Business Info (used in invoices and WhatsApp messages) ───────────────────
VITE_BUSINESS_NAME=Ceylon Platinum Trading
VITE_BUSINESS_PHONE=+94766016005
VITE_BUSINESS_ADDRESS=Matara, Southern Province, Sri Lanka
VITE_BUSINESS_EMAIL=celonglobal.hq@gmail.com

# ── Daily Reorder Notification Time (24h format) ─────────────────────────────
# The modal pops up at this time to confirm reorders to suppliers
VITE_REORDER_TIME=17:30


